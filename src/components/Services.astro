---
const services = [
	{
		name: "DESARROLLO WEB",
		description:
			"Sitios, plataformas y e-commerce construidos para durar. Código artesanal, arquitectura escalable y cero parches de urgencia.",
		tags: ["Sitios Web", "E-commerce", "Plataformas", "Apps a medida", "Next.js", "Astro"],
		accent: "neon",
	},
	{
		name: "DISEÑO",
		description:
			"Identidad visual y experiencia digital que comunican antes de que el usuario lea una sola palabra.",
		tags: ["UI/UX Web", "Identidad Visual", "Brandbook", "Logotipos", "Design System"],
		accent: "primary",
	},
	{
		name: "MARKETING DIGITAL",
		description:
			"Tráfico con intención, campañas que convierten y estrategias que escalan sin quemar presupuesto.",
		tags: ["SEO", "SEM", "Google Ads", "Meta Ads", "Analytics", "CRO"],
		accent: "neon",
	},
	{
		name: "CONTENIDO",
		description:
			"Palabras que venden, historias que conectan y formatos que hacen que tu audiencia regrese.",
		tags: ["Estrategia Editorial", "Redes Sociales", "Copywriting", "Email Marketing"],
		accent: "primary",
	},
];
---

<section id="servicios" class="relative bg-surface py-26 lg:py-38">
	<span class="strand-node" aria-hidden="true"></span>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(57,255,20,0.04),transparent_55%)]"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-6 reveal">
		<div class="mb-16 flex flex-col gap-4 lg:mb-20 lg:flex-row lg:items-end lg:justify-between">
			<h2
				class="font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl"
			>
				EL ECOSISTEMA<br />COMPLETO
			</h2>
			<p class="max-w-xs text-base leading-relaxed text-muted lg:text-right">
				Un solo equipo para cada pieza de tu presencia digital.
			</p>
		</div>

		<div>
			{
				services.map((service) => {
					const isNeon = service.accent === "neon";
					return (
						<article class="group relative border-t border-line transition-colors duration-300 hover:bg-surface-2/50">
							<span
								aria-hidden="true"
								class:list={[
									"pointer-events-none absolute top-[2.6rem] left-3 size-2 rotate-45 opacity-0 transition-opacity duration-300 group-hover:opacity-100 lg:top-[3.1rem]",
									isNeon ? "bg-neon shadow-glow-neon" : "bg-primary shadow-glow-primary",
								]}
							>
							</span>

							<div class="relative flex items-center gap-5 px-8 py-8 lg:gap-8 lg:px-10 lg:py-10">
								<h3
									class:list={[
										"flex-1 font-heading text-3xl font-black tracking-tight transition-colors duration-300 sm:text-4xl lg:text-5xl xl:text-6xl",
										isNeon
											? "text-text group-hover:text-neon-ink"
											: "text-text group-hover:text-primary-ink",
									]}
								>
									{service.name}
								</h3>

								<div
									class:list={[
										"flex size-10 shrink-0 items-center justify-center rounded-sm border border-line-strong text-disabled transition-all duration-300 lg:size-12",
										isNeon
											? "group-hover:border-neon group-hover:text-neon-ink"
											: "group-hover:border-primary group-hover:text-primary-ink",
									]}
									aria-hidden="true"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 lg:size-5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M7 17L17 7M17 7H7M17 7v10"
										/>
									</svg>
								</div>
							</div>

							<div class="service-expand">
								<div class="min-h-0 overflow-hidden">
									<div class="px-8 pb-8 lg:px-10">
										<p class="mb-5 max-w-2xl text-base leading-relaxed text-muted">
											{service.description}
										</p>
										<div class="flex flex-wrap gap-2">
											{service.tags.map((tag) => (
												<span
													class:list={[
														"rounded-sm border px-3 py-1.5 font-mono text-2xs font-medium tracking-wider uppercase",
														isNeon
															? "border-neon/30 bg-neon/5 text-neon-ink"
															: "border-primary/30 bg-primary/5 text-primary-ink",
													]}
												>
													{tag}
												</span>
											))}
										</div>
									</div>
								</div>
							</div>
						</article>
					);
				})
			}
			<div class="border-t border-line"></div>
		</div>

		<div class="mt-14 text-center">
			<a
				href="#contacto"
				class="group inline-flex items-center gap-2 rounded-sm border border-line-strong px-7 py-3.5 text-sm font-semibold tracking-wider text-muted uppercase transition-colors hover:border-neon hover:text-text"
			>
				¿No sabes qué necesitas? Hablemos
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="size-4 transition-transform group-hover:translate-x-0.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style is:global>
	/* CSS grid-template-rows trick for smooth height transition */
	.service-expand {
		display: grid;
		grid-template-rows: 1fr; /* mobile: always expanded */
		transition: grid-template-rows 0.5s ease-out;
	}

	@media (min-width: 768px) {
		.service-expand {
			grid-template-rows: 0fr; /* desktop default: collapsed */
		}
		.group:hover .service-expand {
			grid-template-rows: 1fr; /* desktop hover: expanded */
		}
	}
</style>
