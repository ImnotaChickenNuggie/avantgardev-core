---
const services = [
	{
		number: "01",
		name: "DESARROLLO WEB",
		description:
			"Sitios, plataformas y e-commerce construidos para durar. Código artesanal, arquitectura escalable y cero parches de urgencia.",
		tags: ["Sitios Web", "E-commerce", "Plataformas", "Apps a medida", "Next.js", "Astro"],
		accent: "neon",
	},
	{
		number: "02",
		name: "DISEÑO",
		description:
			"Identidad visual y experiencia digital que comunican antes de que el usuario lea una sola palabra.",
		tags: ["UI/UX Web", "Identidad Visual", "Brandbook", "Logotipos", "Design System"],
		accent: "primary",
	},
	{
		number: "03",
		name: "MARKETING DIGITAL",
		description:
			"Tráfico con intención, campañas que convierten y estrategias que escalan sin quemar presupuesto.",
		tags: ["SEO", "SEM", "Google Ads", "Meta Ads", "Analytics", "CRO"],
		accent: "neon",
	},
	{
		number: "04",
		name: "CONTENIDO",
		description:
			"Palabras que venden, historias que conectan y formatos que hacen que tu audiencia regrese.",
		tags: ["Estrategia Editorial", "Redes Sociales", "Copywriting", "Email Marketing"],
		accent: "primary",
	},
];
---

<section id="servicios" class="relative bg-surface py-26 lg:py-38">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(57,255,20,0.03),transparent_55%)]"
	/>

	<div class="relative mx-auto max-w-7xl px-6 reveal">
		<!-- Header -->
		<div class="mb-16 lg:mb-20">
			<p class="mb-4 font-mono text-xs font-medium tracking-[0.3em] text-neon uppercase">
				Nuestras disciplinas
			</p>
			<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
				<h2
					class="font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl"
				>
					EL ECOSISTEMA<br />COMPLETO
				</h2>
				<p class="max-w-xs text-base leading-relaxed text-muted lg:text-right">
					Un solo equipo para cada pieza de tu presencia digital.
				</p>
			</div>
		</div>

		<!-- Service rows -->
		<div>
			{
				services.map((service) => {
					const isNeon = service.accent === "neon";
					return (
						<article class="group relative border-t border-border/40">
							{/* Ghost number watermark */}
							<span
								class:list={[
									"pointer-events-none absolute right-0 bottom-0 select-none font-heading text-[7rem] font-black leading-none lg:text-[10rem]",
									isNeon ? "text-neon/[0.04]" : "text-primary/[0.05]",
								]}
							>
								{service.number}
							</span>

							{/* Bottom accent line — grows left to right on hover */}
							<div
								class:list={[
									"pointer-events-none absolute bottom-0 left-0 h-px w-0 transition-all duration-700 ease-out group-hover:w-full",
									isNeon ? "bg-neon/50" : "bg-primary/50",
								]}
							/>

							{/* Main row */}
							<div class="relative flex items-center gap-5 py-8 lg:gap-8 lg:py-10">
								{/* Number label */}
								<span class="w-10 shrink-0 pt-0.5 font-mono text-xs font-medium tracking-[0.2em] text-disabled lg:w-14">
									{service.number}
								</span>

								{/* Service name */}
								<h3
									class:list={[
										"flex-1 font-heading text-3xl font-black tracking-tight transition-colors duration-300 sm:text-4xl lg:text-5xl xl:text-6xl",
										isNeon
											? "text-text group-hover:text-neon"
											: "text-text group-hover:text-primary",
									]}
								>
									{service.name}
								</h3>

								{/* Arrow icon */}
								<div
									class:list={[
										"flex size-10 shrink-0 items-center justify-center rounded-full border transition-all duration-300 lg:size-12",
										isNeon
											? "border-border/30 text-disabled group-hover:border-neon/40 group-hover:bg-neon/5 group-hover:text-neon"
											: "border-border/30 text-disabled group-hover:border-primary/40 group-hover:bg-primary/5 group-hover:text-primary",
									]}
									aria-hidden="true"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 lg:size-5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M7 17L17 7M17 7H7M17 7v10"
										/>
									</svg>
								</div>
							</div>

							{/* Expandable: description + tags (mobile always open, desktop hover-reveal) */}
							<div class="service-expand">
								<div class="min-h-0 overflow-hidden">
									<div class="pb-8 pl-[3.75rem] lg:pl-22">
										<p class="mb-5 max-w-2xl text-base leading-relaxed text-muted">
											{service.description}
										</p>
										<div class="flex flex-wrap gap-2">
											{service.tags.map((tag) => (
												<span
													class:list={[
														"rounded-md border px-3 py-1.5 font-mono text-2xs font-medium tracking-wider uppercase",
														isNeon
															? "border-neon/20 bg-neon/5 text-neon"
															: "border-primary/20 bg-primary/5 text-primary",
													]}
												>
													{tag}
												</span>
											))}
										</div>
									</div>
								</div>
							</div>
						</article>
					);
				})
			}
			<!-- Final border -->
			<div class="border-t border-border/40"></div>
		</div>

		<!-- Bottom CTA -->
		<div class="mt-14 text-center">
			<a
				href="#contacto"
				class="group inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm font-semibold tracking-wider text-muted uppercase transition-all hover:border-text/30 hover:text-text"
			>
				¿No sabes qué necesitas? Hablemos
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="size-4 transition-transform group-hover:translate-x-0.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style is:global>
	/* CSS grid-template-rows trick for smooth height transition */
	.service-expand {
		display: grid;
		grid-template-rows: 1fr; /* mobile: always expanded */
		transition: grid-template-rows 0.5s ease-out;
	}

	@media (min-width: 768px) {
		.service-expand {
			grid-template-rows: 0fr; /* desktop default: collapsed */
		}
		.group:hover .service-expand {
			grid-template-rows: 1fr; /* desktop hover: expanded */
		}
	}
</style>
