---
import { hudStatus } from "@/data/hud-labels";
import ColorBends from "./ColorBends";
---

<section class="relative min-h-screen overflow-hidden pt-24">
	<!-- Background: ColorBends shader -->
	<div class="pointer-events-none absolute inset-0 opacity-70 dark:opacity-100">
		<ColorBends
			client:idle
			rotation={-16}
			speed={0.15}
			colors={["#6b10b8","#0a8f2a","#7a06c4"]}
			transparent
			autoRotate={1}
			scale={1.5}
			frequency={1}
			warpStrength={1}
			mouseInfluence={0.2}
			parallax={1.5}
			noise={0.1}
			className="pointer-events-auto!"
			style={{ width: '100%', height: '100%', position: 'absolute', inset: 0, opacity: 0.7 }}
		/>
	</div>

	<div class="relative mx-auto flex max-w-7xl flex-col-reverse items-center gap-12 px-6 py-20 lg:flex-row lg:gap-0 lg:py-34">
		<!-- Left: Copy -->
		<div class="flex flex-1 flex-col items-center text-center lg:items-start lg:text-left">
			<h1
				class="font-heading text-4xl md:text-5xl leading-[0.95] font-black tracking-tight text-text hud-glitch sm:text-6xl lg:text-7xl xl:text-8xl"
			>
				<span class="sr-only">Agencia de Desarrollo Web, Marketing Digital y Diseño en México </span>
				TRANSFORMAMOS
				<br />
				IDEAS EN
				<br />
				<span class="text-neon-ink">REALIDADES</span>
			</h1>

			<p class="mt-8 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
				Desarrollo web, diseño, marketing digital y contenido que trabajan
				juntos para que tu marca crezca en serio.
			</p>

			<div class="mt-10 flex flex-wrap items-center gap-4">
				<a
					href="#contacto"
					class="hud-scan group relative inline-flex items-center gap-2 rounded-sm bg-primary px-7 py-3.5 text-sm font-semibold tracking-wider text-white uppercase transition-all hover:bg-primary-hover hover:shadow-glow-primary"
				>
					Conectemos
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
					</svg>
				</a>
				<a
					href="#proyectos"
					class="inline-flex items-center gap-2 rounded-sm border border-line-strong px-7 py-3.5 text-sm font-semibold tracking-wider text-muted uppercase transition-colors hover:border-hud hover:text-text"
				>
					Ver proyectos
				</a>
			</div>
		</div>
	</div>

	<!-- HUD strip: datos de instrumento, no decoración -->
	<div class="relative z-10 mx-auto max-w-7xl px-6 pb-8">
		<div class="hud-tick mb-3"></div>
		<div class="hud-tag flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<span class="inline-flex items-center gap-2">
				<span class="inline-block size-1.5 animate-glow-pulse bg-neon"></span>
				{hudStatus.online}
			</span>
			<span class="hidden sm:inline">{hudStatus.location}</span>
			<a href="#servicios" class="text-hud transition-colors hover:text-text">
				{hudStatus.scanning} ↓
			</a>
		</div>
	</div>

	<!-- Bottom fade -->
	<div
		class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-t from-bg to-transparent"
	/>
</section>
