---
const steps = [
	{
		number: "01",
		title: "Inmersión",
		subtitle: "Entendemos tu visión",
		description:
			"Entendemos tu negocio, tu mercado y tu audiencia antes de escribir código, diseñar o publicar contenido.",
		accent: "neon",
	},
	{
		number: "02",
		title: "Definición",
		subtitle: "Trazamos el camino",
		description:
			"Definimos alcance, canales y métricas. Sin paquetes genéricos: solo lo que tu proyecto necesita.",
		accent: "primary",
	},
	{
		number: "03",
		title: "Creación",
		subtitle: "Construimos el futuro",
		description:
			"Construimos en iteraciones cortas: diseño, desarrollo y contenido moviéndose al mismo tiempo.",
		accent: "neon",
	},
	{
		number: "04",
		title: "Despegue",
		subtitle: "Tu realidad digital",
		description:
			"Lanzamos, medimos y ajustamos. El trabajo no termina con la entrega — te acompañamos mientras creces.",
		accent: "primary",
	},
];
---

<section id="metodologia" class="relative bg-surface py-26 lg:py-38">
	<span class="strand-node" aria-hidden="true"></span>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(124,58,237,0.06),transparent_50%)]"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-6 reveal">
		<h2
			class="mb-18 max-w-3xl font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:mb-24 lg:text-6xl"
		>
			METODOLOGÍA EVOLUTIVA
		</h2>

		<ol class="relative grid gap-12 lg:grid-cols-4 lg:gap-8">
			<div
				class="pointer-events-none absolute top-[13px] right-0 left-0 hidden h-px bg-line-strong lg:block"
			>
			</div>
			{
				steps.map((step) => {
					const isNeon = step.accent === "neon";
					return (
						<li class="group relative border-l border-line-strong pl-8 lg:border-l-0 lg:pl-0">
							<span
								aria-hidden="true"
								class:list={[
									"absolute top-1 -left-[6px] size-[11px] rotate-45 border bg-bg transition-all duration-300 lg:top-2 lg:left-0",
									isNeon
										? "border-neon group-hover:bg-neon group-hover:shadow-glow-neon"
										: "border-primary group-hover:bg-primary group-hover:shadow-glow-primary",
								]}
							>
							</span>

							<span
								class:list={[
									"mb-6 block font-heading text-5xl font-black lg:mt-8 lg:text-6xl",
									isNeon ? "text-neon-ink" : "text-primary-ink",
								]}
							>
								{step.number}
							</span>

							<h3 class="mb-1 text-2xl font-bold tracking-tight text-text">{step.title}</h3>
							<p
								class:list={[
									"mb-4 text-sm font-semibold",
									isNeon ? "text-neon-ink" : "text-primary-ink",
								]}
							>
								{step.subtitle}
							</p>
							<p class="leading-relaxed text-muted">{step.description}</p>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>
