---
import { projects } from "../data/projects";

// Filas de 12 columnas: pares 7+5 / 5+7 alternados; si queda uno suelto, ocupa la fila completa.
const pairs = [
	[7, 5],
	[5, 7],
];
const spans = projects.map((_, i) => {
	const row = Math.floor(i / 2);
	const isLoneLast = i === projects.length - 1 && projects.length % 2 === 1;
	return isLoneLast ? 12 : pairs[row % 2][i % 2];
});
const spanClass: Record<number, string> = {
	5: "lg:col-span-5",
	7: "lg:col-span-7",
	12: "lg:col-span-12 lg:flex-row",
};
---

<section id="proyectos" class="relative py-26 lg:py-38">
	<span class="strand-node" aria-hidden="true"></span>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_30%,rgba(124,58,237,0.06),transparent_60%)]"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-6">
		<div class="reveal mb-18 flex flex-col items-start gap-6 lg:flex-row lg:items-end lg:justify-between">
			<h2 class="font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl">
				TRABAJO QUE<br />
				<span class="text-neon-ink">HABLA POR SI SOLO</span>
			</h2>
			<p class="max-w-md text-base leading-relaxed text-muted lg:text-right">
				Resultados reales para marcas que se atrevieron a hacer las cosas diferente.
			</p>
		</div>

		<div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
			{
				projects.map((project, i) => {
					const span = spans[i];
					const colSpan = spanClass[span];
					const isNeon = project.accent === "neon";

					return (
						<article
							class:list={[
								"group reveal relative flex flex-col rounded-sm border border-line bg-surface/40 transition-all duration-500",
								colSpan,
								isNeon
									? "hover:border-neon/60 hover:shadow-glow-neon"
									: "hover:border-primary/60 hover:shadow-glow-primary",
							]}
						>
							{/* Portada: placeholder hasta que existan capturas reales en public/projects */}
							<div
								class:list={[
									"cut-corner relative aspect-[16/10] w-full overflow-hidden bg-surface-2",
									span === 12 && "lg:w-7/12 lg:shrink-0",
								]}
								transition:name={`project-image-${project.slug}`}
							>
								<div
									class:list={[
										"absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105",
										isNeon
											? "bg-[radial-gradient(ellipse_at_30%_20%,rgba(57,255,20,0.14),transparent_60%),radial-gradient(ellipse_at_80%_90%,rgba(124,58,237,0.16),transparent_55%)]"
											: "bg-[radial-gradient(ellipse_at_30%_20%,rgba(124,58,237,0.2),transparent_60%),radial-gradient(ellipse_at_80%_90%,rgba(57,255,20,0.1),transparent_55%)]",
									]}
								>
								</div>

								<span
									aria-hidden="true"
									class:list={[
										"pointer-events-none absolute inset-0 flex items-center justify-center font-heading text-[11rem] font-black leading-none select-none transition-transform duration-700 ease-out group-hover:scale-110",
										isNeon ? "text-neon/[0.12]" : "text-primary/[0.16]",
									]}
								>
									{project.title.charAt(0)}
								</span>

								<span
									class:list={[
										"absolute top-5 left-5 z-10 rounded-sm border bg-bg/70 px-3 py-1 font-mono text-2xs font-medium tracking-[0.2em] uppercase",
										isNeon
											? "border-neon/40 text-neon-ink"
											: "border-primary/40 text-primary-ink",
									]}
								>
									{project.category}
								</span>

								<div
									class:list={[
										"absolute right-5 bottom-5 z-10 flex size-11 translate-y-3 items-center justify-center rounded-sm border bg-bg/80 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100",
										isNeon ? "border-neon text-neon-ink" : "border-primary text-primary-ink",
									]}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
									</svg>
								</div>
							</div>

							<div class="flex flex-1 flex-col justify-between p-7 lg:p-9">
								<div>
									<h3
										class="mb-2 text-2xl font-bold tracking-tight text-text lg:text-3xl"
										transition:name={`project-title-${project.slug}`}
									>
										{project.title}
									</h3>
									<p class="mb-5 text-sm leading-relaxed text-muted lg:text-base">
										{project.description}
									</p>
								</div>

								<div class="flex flex-wrap gap-2" transition:name={`project-tags-${project.slug}`}>
									{project.tags.map((tag) => (
										<span class="rounded-sm border border-line px-2.5 py-1 font-mono text-2xs font-medium tracking-wider text-muted uppercase transition-colors group-hover:border-line-strong">
											{tag}
										</span>
									))}
								</div>
							</div>

							<a
								href={`/proyecto/${project.slug}`}
								class="absolute inset-0 z-20"
								aria-label={`Ver proyecto ${project.title}`}
							></a>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
