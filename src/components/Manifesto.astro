---
const values = [
	{
		title: "IA InnecesarIA",
		description:
			"No implementamos tecnología por tendencia. La usamos solo si aporta un valor real a tu sueño.",
	},
	{
		title: "Prioridad Humana",
		description:
			"Tu idea es el centro. No buscamos imponer nuestra visión, sino potenciar la tuya hasta alcanzar el resultado que esperas.",
	},
	{
		title: "Artesanía Digital",
		description:
			"No generamos basura digital. Cada línea de código y cada píxel tiene una razón de ser. Buscamos la eficiencia y durabilidad por encima de la inmediatez.",
	},
	{
		title: "Transparencia Radical",
		description:
			"Te diremos la verdad, aunque signifique venderte menos. Preferimos un proyecto sólido y honesto que uno inflado con promesas técnicas que no necesitas.",
	},
	{
		title: "Profesionalismo al mando",
		description:
			"Avantgardev es un conjunto de profesionales visionarios que buscan generar soluciones listas para crecer, no “vibe coding” listo en 5 minutos para que termines más de 6 meses reestructurando tu proyecto después.",
	},
	{
		title: "Ingeniería con Alma",
		description: 'Codeamos con el cerebro y diseñamos con el alma; no "vibramos" con el código.',
	},
];
---

<section id='manifiesto' class='relative py-26 lg:py-38'>
	<span class='strand-node' aria-hidden='true'></span>
	<div class='mx-auto grid max-w-7xl gap-12 px-6 reveal lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20'>
		<div class='lg:sticky lg:top-32 lg:self-start'>
			<h2
				class='font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl'
			>
				EN LO QUE<br />CREEMOS
			</h2>
			<p class='mt-6 max-w-sm leading-relaxed text-muted'>
				Seis ideas que guían cada decisión, de la primera línea de código al último píxel.
			</p>
		</div>

		<div>
			{
				values.map((value) => (
					<article class='group relative border-t border-line py-9 last:border-b lg:py-11'>
						<span
							aria-hidden='true'
							class='pointer-events-none absolute top-[2.9rem] -left-5 hidden size-2 rotate-45 bg-neon opacity-0 shadow-glow-neon transition-opacity duration-300 group-hover:opacity-100 lg:top-[3.4rem] lg:block'
						>
						</span>
						<h3 class='mb-3 text-xl font-bold tracking-tight text-text transition-colors duration-300 group-hover:text-neon-ink sm:text-2xl'>
							{value.title}
						</h3>
						<p class='max-w-xl leading-relaxed text-muted'>
							{value.description}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>
