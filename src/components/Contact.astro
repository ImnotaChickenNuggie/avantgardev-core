---
import ContactForm from "./ContactForm";
---

<section
	id='contacto'
	class='relative bg-surface py-26 lg:py-38'
>
	<span class='strand-node' aria-hidden='true'></span>
	<!-- Background glow -->
	<div
		class='pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(57,255,20,0.03),transparent_50%)]'
	>
	</div>

	<div class='relative mx-auto grid max-w-7xl gap-12 px-6 reveal lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20'>
		<div>
			<h2
				class='font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl'
			>
				DALE VIDA<br />A TU <span class='text-neon-ink'>IDEA</span>
			</h2>
			<p class='mt-6 max-w-md text-lg leading-relaxed text-muted'>
				Cuéntanos qué quieres construir. Nosotros te decimos cómo hacerlo
				realidad — con desarrollo, diseño, marketing o todo junto.
			</p>
		</div>

		<div class='w-full max-w-xl'>
			<ContactForm client:visible />
		</div>
	</div>
</section>
