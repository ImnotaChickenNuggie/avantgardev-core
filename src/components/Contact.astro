---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import ContactForm from "./ContactForm";
---

<section
	id='contacto'
	class='relative bg-surface py-26 lg:py-38'
>
	<!-- Background glow -->
	<div
		class='pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(57,255,20,0.03),transparent_50%)]'
	>
	</div>

	<div class='relative mx-auto max-w-4xl px-6 reveal'>
		<div class='mb-14 text-center'>
			<p
				class='mb-4 font-mono text-xs font-medium tracking-[0.3em] text-neon uppercase'
			>
				Comencemos
			</p>
			<h2
				class='font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl'
			>
				DALE VIDA A TU IDEA
			</h2>
			<p
				class='mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted'
			>
				No dejes que una gran idea se quede en el papel. Únete a nuestro
				colectivo disruptivo y hablemos de como potenciar tu proyecto
				con tecnología y diseño de vanguardia.
			</p>
		</div>

		<div class='mx-auto max-w-xl'>
			<ContactForm client:visible />
		</div>
	</div>
</section>

<!-- Footer -->
<footer class='border-t border-border/30 bg-bg py-8'>
	<div
		class='mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 sm:flex-row'
	>
		<a
			href='/'
			class='flex flex-row space-x-2 items-center'
		>
			<Image
				src={logo}
				alt='Avantgardev'
				height={24}
				quality='medium'
				class='dark:invert-0 invert'
			/>
			<span
				class='font-heading text-lg font-black tracking-tight text-text'
				>AVANTGARDEV</span
			>
		</a>
		<div class='flex items-center gap-6'>
			<a
				href='https://www.instagram.com/avantgardev/'
				target='_blank'
				rel='noopener noreferrer'
				class='flex items-center gap-2 text-xs text-disabled transition-colors hover:text-text'
			>
				<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
					<rect width='20' height='20' x='2' y='2' rx='5' ry='5'/>
					<path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'/>
					<line x1='17.5' x2='17.51' y1='6.5' y2='6.5'/>
				</svg>
				avantgardev
			</a>
			<a
				href='mailto:contacto@avantgardev.com.mx'
				class='flex items-center gap-2 text-xs text-disabled transition-colors hover:text-text'
			>
				<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
					<rect width='20' height='16' x='2' y='4' rx='2'/>
					<path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'/>
				</svg>
				contacto@avantgardev.com.mx
			</a>
		</div>
		<p class='text-xs text-disabled'>
			&copy; {new Date().getFullYear()} Avantgardev. Todos los derechos reservados.
		</p>
	</div>
</footer>
