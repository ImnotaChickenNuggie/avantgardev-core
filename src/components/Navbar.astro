---
// biome-ignore lint/correctness/noUnusedImports: used in template
import { Image } from "astro:assets";
// biome-ignore lint/correctness/noUnusedImports: used in template
import logo from "../assets/logo.webp";
// biome-ignore lint/correctness/noUnusedImports: used in template
import MobileMenu from "./MobileMenu";
// biome-ignore lint/correctness/noUnusedImports: used in template
import ThemeToggle from "./ThemeToggle";

const links = [
	{ href: "#servicios", label: "Servicios" },
	{ href: "#manifiesto", label: "Manifiesto" },
	{ href: "#metodologia", label: "Metodología" },
	{ href: "#proyectos", label: "Proyectos" },
	{ href: "#faqs", label: "FAQ's" },
];
---

<header
	class='fixed top-0 left-0 z-50 hidden w-full border-b border-line bg-bg/90 md:block'
>
	<nav class='mx-auto flex max-w-7xl items-center justify-between px-6 py-4'>
		<a href='/' class='flex flex-row items-center space-x-2'>
			<Image
				src={logo}
				alt='Avantgardev'
				height={36}
				quality='high'
				class='dark:invert-0 invert'
			/>
			<span class='font-heading text-2xl'>AVANTGARDEV</span>
		</a>

		<ul class='hidden items-center gap-8 md:flex'>
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class='group relative py-1 text-sm font-medium tracking-wide text-muted uppercase transition-colors hover:text-text'
						>
							{link.label}
							<span class='absolute -bottom-0.5 left-0 h-px w-0 bg-neon transition-all duration-300 ease-out group-hover:w-full' />
						</a>
					</li>
				))
			}
		</ul>

		<div class='hidden items-center gap-3 md:flex'>
			<ThemeToggle client:load />
			<a
				href='#contacto'
				class='rounded-sm border border-neon/40 px-5 py-2 text-sm font-semibold tracking-widest text-neon-ink uppercase transition-all hover:border-neon hover:bg-neon/10 hover:shadow-glow-neon'
			>
				CONECTEMOS
			</a>
		</div>
	</nav>
</header>

<!-- Mobile StaggeredMenu (only visible on mobile) -->
<div class='z-[60] md:hidden'>
	<MobileMenu client:only='react' />
</div>
