---
// biome-ignore lint/correctness/noUnusedImports: used in template
import { Image } from "astro:assets";
import { hudSections } from "@/data/hud-labels";
// biome-ignore lint/correctness/noUnusedImports: used in template
import logo from "../assets/logo.webp";
// biome-ignore lint/correctness/noUnusedImports: used in template
import MobileMenu from "./MobileMenu";
// biome-ignore lint/correctness/noUnusedImports: used in template
import ThemeToggle from "./ThemeToggle";

const links = [
	{ href: "#servicios", ...hudSections.servicios },
	{ href: "#manifiesto", ...hudSections.manifiesto },
	{ href: "#metodologia", ...hudSections.metodologia },
	{ href: "#proyectos", ...hudSections.proyectos },
	{ href: "#faqs", ...hudSections.faqs },
];
---

<header
	class='fixed top-0 left-0 z-50 hidden w-full border-b border-line bg-bg/90 md:block'
>
	<nav class='mx-auto flex max-w-7xl items-center justify-between px-6 py-4'>
		<a href='/' class='flex flex-row items-center space-x-2'>
			<Image
				src={logo}
				alt='Avantgardev'
				height={36}
				quality='high'
				class='dark:invert-0 invert'
			/>
			<span class='font-heading text-2xl'>AVANTGARDEV</span>
		</a>

		<ul class='hidden items-center gap-7 md:flex'>
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class='hud-tag group flex items-baseline gap-1.5 py-1 transition-colors hover:text-text focus-visible:text-text'
						>
							<span class='text-hud'>{link.index}</span>
							<span class='border-b border-transparent transition-colors group-hover:border-hud'>
								{link.label}
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class='hidden items-center gap-3 md:flex'>
			<ThemeToggle client:load />
			<a
				href='#contacto'
				class='hud-scan rounded-sm border border-hud px-5 py-2 text-xs font-semibold tracking-widest text-hud uppercase transition-colors hover:bg-hud-muted'
			>
				CONECTEMOS
			</a>
		</div>
	</nav>
</header>

<!-- Mobile StaggeredMenu (only visible on mobile) -->
<div class='z-[60] md:hidden'>
	<MobileMenu client:only='react' />
</div>
