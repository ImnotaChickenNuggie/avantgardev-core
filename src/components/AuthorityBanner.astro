---
import amanal from "../assets/brands/amanal.webp";
import capitalHumano from "../assets/brands/capital-humano.webp";
import magnapelle from "../assets/brands/magnapelle.webp";
import vazza from "../assets/brands/vazza.webp";

const _brands = [
	{ src: capitalHumano, alt: "Capital Humano" },
	{ src: amanal, alt: "Amanal" },
	{ src: magnapelle, alt: "Magnapelle" },
	{ src: vazza, alt: "Vazza" },
];
---

<section
	class='relative overflow-hidden border-y border-line bg-surface py-14'
>
	<div class='mx-auto max-w-7xl px-6 reveal'>
		<p
			class='mb-10 text-center font-mono text-xs font-medium tracking-[0.3em] text-muted uppercase'
		>
			Marcas que ya crecen con nosotros
		</p>
	</div>

	<!-- Marquee -->
	<div class='group relative'>
		<!-- Fade edges -->
		<div
			class='pointer-events-none absolute top-0 left-0 z-10 h-full w-24 bg-gradient-to-r from-surface to-transparent'
		>
		</div>
		<div
			class='pointer-events-none absolute top-0 right-0 z-10 h-full w-24 bg-gradient-to-l from-surface to-transparent'
		>
		</div>

		<div
			class='flex animate-marquee items-center gap-16 group-hover:paused'
		>
			{
				[...Array(6)].map((_, copy) => (
					<div class='flex shrink-0 items-center gap-16' aria-hidden={copy > 0 ? "true" : undefined}>
						{_brands.map(({ src, alt }) => (
							<img
								src={src.src}
								alt={copy > 0 ? "" : alt}
								width={120}
								height={72}
								class='h-12 w-[120px] object-contain select-none grayscale dark:opacity-40 dark:invert-0 opacity-60 invert'
							/>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
