---
import Navbar from "../../components/Navbar.astro";
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const isNeon = project.accent === "neon";
---

<Layout
	title={`${project.title} — Avantgardev`}
	description={project.description}
>
	<Navbar />

	<main>
		<section class="relative overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-26">
			<div
				class:list={[
					"pointer-events-none absolute inset-0",
					isNeon
						? "bg-[radial-gradient(ellipse_at_50%_0%,rgba(57,255,20,0.06),transparent_60%)]"
						: "bg-[radial-gradient(ellipse_at_50%_0%,rgba(124,58,237,0.08),transparent_60%)]",
				]}
			>
			</div>

			<div class="relative mx-auto max-w-7xl px-6">
				<a
					href="/#proyectos"
					class="group mb-10 inline-flex items-center gap-2 font-mono text-xs font-medium tracking-[0.2em] text-muted uppercase transition-colors hover:text-text"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4 transition-transform group-hover:-translate-x-1"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
					</svg>
					Volver a proyectos
				</a>

				<div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-18">
					<div>
						<span
							class:list={[
								"mb-5 inline-block rounded-sm border px-3 py-1 font-mono text-2xs font-medium tracking-[0.2em] uppercase",
								isNeon ? "border-neon/40 text-neon-ink" : "border-primary/40 text-primary-ink",
							]}
						>
							{project.category}
						</span>

						<h1
							class="mb-6 font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl xl:text-7xl"
							transition:name={`project-title-${project.slug}`}
						>
							{project.title.toUpperCase()}
						</h1>

						<p class="mb-8 max-w-xl text-lg leading-relaxed text-muted">
							{project.longDescription}
						</p>

						<div class="flex flex-wrap gap-2" transition:name={`project-tags-${project.slug}`}>
							{project.tags.map((tag) => (
								<span
									class:list={[
										"rounded-sm border px-3 py-1.5 font-mono text-2xs font-medium tracking-wider uppercase",
										isNeon
											? "border-neon/30 bg-neon/5 text-neon-ink"
											: "border-primary/30 bg-primary/5 text-primary-ink",
									]}
								>
									{tag}
								</span>
							))}
						</div>

						<dl class="mt-10 grid grid-cols-2 gap-6 border-t border-line pt-8 sm:grid-cols-3">
							<div>
								<dt class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-muted uppercase">Cliente</dt>
								<dd class="text-sm font-semibold text-text">{project.client}</dd>
							</div>
							<div>
								<dt class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-muted uppercase">Año</dt>
								<dd class="text-sm font-semibold text-text">{project.year}</dd>
							</div>
							{project.url && (
								<div>
									<dt class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-muted uppercase">Sitio web</dt>
									<dd>
										<a
											href={project.url}
											target="_blank"
											rel="noopener noreferrer"
											class:list={[
												"inline-flex items-center gap-1 text-sm font-semibold transition-colors hover:text-text",
												isNeon ? "text-neon-ink" : "text-primary-ink",
											]}
										>
											Visitar
											<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
											</svg>
										</a>
									</dd>
								</div>
							)}
						</dl>
					</div>

					<div
						class="cut-corner relative aspect-[4/3] overflow-hidden bg-surface-2"
						transition:name={`project-image-${project.slug}`}
					>
						<div
							class:list={[
								"absolute inset-0",
								isNeon
									? "bg-[radial-gradient(ellipse_at_30%_20%,rgba(57,255,20,0.14),transparent_60%),radial-gradient(ellipse_at_80%_90%,rgba(124,58,237,0.16),transparent_55%)]"
									: "bg-[radial-gradient(ellipse_at_30%_20%,rgba(124,58,237,0.2),transparent_60%),radial-gradient(ellipse_at_80%_90%,rgba(57,255,20,0.1),transparent_55%)]",
							]}
						>
						</div>
						<div class="absolute inset-0 flex items-center justify-center">
							<span
								aria-hidden="true"
								class:list={[
									"font-heading text-[12rem] font-black leading-none select-none sm:text-[16rem]",
									isNeon ? "text-neon/[0.12]" : "text-primary/[0.16]",
								]}
							>
								{project.title.charAt(0)}
							</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="relative bg-surface py-26 lg:py-38">
			<div class="relative mx-auto max-w-7xl px-6">
				<div class="grid gap-16 lg:grid-cols-2 lg:gap-18">
					<div class="reveal border-t border-line pt-8">
						<h2 class="mb-6 font-heading text-3xl font-black tracking-tight text-text sm:text-4xl">
							EL DESAFÍO
						</h2>
						<p class="text-base leading-relaxed text-muted lg:text-lg">{project.challenge}</p>
					</div>

					<div class="reveal border-t border-line pt-8">
						<h2
							class:list={[
								"mb-6 font-heading text-3xl font-black tracking-tight sm:text-4xl",
								isNeon ? "text-neon-ink" : "text-primary-ink",
							]}
						>
							LA SOLUCIÓN
						</h2>
						<p class="text-base leading-relaxed text-muted lg:text-lg">{project.solution}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="relative py-26 lg:py-38">
			<div class="relative mx-auto max-w-7xl px-6">
				<h2 class="reveal mb-14 font-heading text-3xl font-black tracking-tight text-text sm:text-4xl lg:text-5xl">
					IMPACTO REAL
				</h2>

				<ul class="reveal grid gap-6 sm:grid-cols-3">
					{
						project.results.map((result) => (
							<li
								class:list={[
									"group relative rounded-sm border border-line p-8 transition-all duration-500 lg:p-10",
									isNeon
										? "hover:border-neon/60 hover:shadow-glow-neon"
										: "hover:border-primary/60 hover:shadow-glow-primary",
								]}
							>
								<span
									aria-hidden="true"
									class:list={[
										"mb-6 block size-2 rotate-45",
										isNeon ? "bg-neon shadow-glow-neon" : "bg-primary shadow-glow-primary",
									]}
								>
								</span>
								<p class="text-base font-medium leading-relaxed text-text lg:text-lg">{result}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="relative border-t border-line bg-surface py-18 lg:py-26">
			<div class="mx-auto max-w-4xl px-6 text-center">
				<h2 class="mb-8 font-heading text-3xl font-black tracking-tight text-text sm:text-4xl lg:text-5xl">
					HAGAMOS ALGO<br />
					<span class:list={[isNeon ? "text-neon-ink" : "text-primary-ink"]}>EXTRAORDINARIO</span>
				</h2>
				<div class="flex flex-wrap items-center justify-center gap-4">
					<a
						href="/#contacto"
						class="hud-scan cut-corner group inline-flex items-center gap-2 bg-primary px-7 py-3.5 text-sm font-semibold tracking-wider text-white uppercase transition-all hover:bg-primary-hover"
					>
						Iniciar proyecto
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-4 transition-transform group-hover:translate-x-0.5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
						</svg>
					</a>
					<a
						href="/#proyectos"
						class="inline-flex items-center gap-2 rounded-sm border border-line-strong px-7 py-3.5 text-sm font-semibold tracking-wider text-muted uppercase transition-colors hover:border-neon hover:text-text"
					>
						Ver más proyectos
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
