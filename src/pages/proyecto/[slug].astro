---
import Navbar from "../../components/Navbar.astro";
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const isNeon = project.accent === "neon";
const accentColor = isNeon ? "neon" : "primary";
---

<Layout
	title={`${project.title} — Avantgardev`}
	description={project.description}
>
	<Navbar />

	<main>
		<!-- Hero del proyecto -->
		<section class="relative overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-26">
			<!-- Background -->
			<div
				class:list={[
					"pointer-events-none absolute inset-0",
					isNeon
						? "bg-[radial-gradient(ellipse_at_50%_0%,rgba(57,255,20,0.05),transparent_60%)]"
						: "bg-[radial-gradient(ellipse_at_50%_0%,rgba(124,58,237,0.05),transparent_60%)]",
				]}
			/>

			<div class="relative mx-auto max-w-7xl px-6">
				<!-- Back link -->
				<a
					href="/#proyectos"
					class="group mb-10 inline-flex items-center gap-2 font-mono text-xs font-medium tracking-[0.2em] text-muted uppercase transition-colors hover:text-text"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4 transition-transform group-hover:-translate-x-1"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
					</svg>
					Volver a proyectos
				</a>

				<div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-18">
					<!-- Left: Project info -->
					<div>
						<span
							class:list={[
								"mb-5 inline-block rounded-full border px-3 py-1 font-mono text-2xs font-medium tracking-[0.2em] uppercase",
								isNeon
									? "border-neon/20 bg-neon/10 text-neon"
									: "border-primary/20 bg-primary/10 text-primary",
							]}
						>
							{project.category}
						</span>

						<h1
							class="mb-6 font-heading text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl xl:text-7xl"
							transition:name={`project-title-${project.slug}`}
						>
							{project.title.toUpperCase()}
						</h1>

						<p class="mb-8 max-w-xl text-lg leading-relaxed text-muted">
							{project.longDescription}
						</p>

						<!-- Tags -->
						<div
							class="flex flex-wrap gap-2"
							transition:name={`project-tags-${project.slug}`}
						>
							{project.tags.map((tag) => (
								<span
									class:list={[
										"rounded-md border px-3 py-1.5 font-mono text-2xs font-medium tracking-wider uppercase",
										isNeon
											? "border-neon/20 bg-neon/5 text-neon"
											: "border-primary/20 bg-primary/5 text-primary",
									]}
								>
									{tag}
								</span>
							))}
						</div>

						<!-- Meta info -->
						<div class="mt-10 grid grid-cols-2 gap-6 border-t border-border/30 pt-8 sm:grid-cols-3">
							<div>
								<p class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-disabled uppercase">
									Cliente
								</p>
								<p class="text-sm font-semibold text-text">{project.client}</p>
							</div>
							<div>
								<p class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-disabled uppercase">
									Año
								</p>
								<p class="text-sm font-semibold text-text">{project.year}</p>
							</div>
							{project.url && (
								<div>
									<p class="mb-1 font-mono text-2xs font-medium tracking-[0.2em] text-disabled uppercase">
										Sitio web
									</p>
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										class:list={[
											"inline-flex items-center gap-1 text-sm font-semibold transition-colors",
											isNeon ? "text-neon hover:text-neon/80" : "text-primary hover:text-primary/80",
										]}
									>
										Visitar
										<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
										</svg>
									</a>
								</div>
							)}
						</div>
					</div>

					<!-- Right: Image -->
					<div
						class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-surface"
						transition:name={`project-image-${project.slug}`}
					>
						<div
							class:list={[
								"absolute inset-0",
								isNeon
									? "bg-[linear-gradient(135deg,rgba(57,255,20,0.08)_0%,rgba(14,14,28,0.6)_50%,rgba(124,58,237,0.06)_100%)]"
									: "bg-[linear-gradient(135deg,rgba(124,58,237,0.1)_0%,rgba(14,14,28,0.6)_50%,rgba(57,255,20,0.06)_100%)]",
							]}
						/>
						<div class="absolute inset-0 opacity-[0.03] bg-[repeating-linear-gradient(0deg,transparent,transparent_39px,var(--ag-text)_39px,var(--ag-text)_40px),repeating-linear-gradient(90deg,transparent,transparent_39px,var(--ag-text)_39px,var(--ag-text)_40px)]" />

						<!-- Large project initial -->
						<div class="absolute inset-0 flex items-center justify-center">
							<span
								class:list={[
									"font-heading text-[12rem] font-black leading-none select-none sm:text-[16rem]",
									isNeon ? "text-neon/[0.06]" : "text-primary/[0.07]",
								]}
							>
								{project.title.charAt(0)}
							</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Desafío y Solución -->
		<section class="relative bg-surface py-26 lg:py-38">
			<div
				class:list={[
					"pointer-events-none absolute inset-0",
					isNeon
						? "bg-[radial-gradient(ellipse_at_30%_50%,rgba(57,255,20,0.03),transparent_50%)]"
						: "bg-[radial-gradient(ellipse_at_30%_50%,rgba(124,58,237,0.03),transparent_50%)]",
				]}
			/>

			<div class="relative mx-auto max-w-7xl px-6">
				<div class="grid gap-16 lg:grid-cols-2 lg:gap-18">
					<!-- Desafío -->
					<div class="reveal">
						<span
							class:list={[
								"mb-4 inline-block font-mono text-xs font-bold tracking-[0.3em] uppercase",
								isNeon ? "text-neon" : "text-primary",
							]}
						>
							El desafío
						</span>
						<h2 class="mb-6 text-2xl font-bold tracking-tight text-text sm:text-3xl">
							¿Qué problema resolvimos?
						</h2>
						<p class="text-base leading-relaxed text-muted lg:text-lg">
							{project.challenge}
						</p>
					</div>

					<!-- Solución -->
					<div class="reveal">
						<span
							class:list={[
								"mb-4 inline-block font-mono text-xs font-bold tracking-[0.3em] uppercase",
								isNeon ? "text-neon" : "text-primary",
							]}
						>
							Nuestra solución
						</span>
						<h2 class="mb-6 text-2xl font-bold tracking-tight text-text sm:text-3xl">
							¿Cómo lo logramos?
						</h2>
						<p class="text-base leading-relaxed text-muted lg:text-lg">
							{project.solution}
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Resultados -->
		<section class="relative py-26 lg:py-38">
			<div class="relative mx-auto max-w-7xl px-6">
				<div class="reveal mb-14 text-center">
					<span
						class:list={[
							"mb-4 inline-block font-mono text-xs font-bold tracking-[0.3em] uppercase",
							isNeon ? "text-neon" : "text-primary",
						]}
					>
						Resultados
					</span>
					<h2 class="font-heading text-3xl font-black tracking-tight text-text sm:text-4xl lg:text-5xl">
						IMPACTO REAL
					</h2>
				</div>

				<div class="reveal grid gap-6 sm:grid-cols-3">
					{
						project.results.map((result, i) => (
							<div
								class:list={[
									"group relative overflow-hidden rounded-2xl border p-8 text-center transition-all duration-500 lg:p-10",
									isNeon
										? "border-neon/10 hover:border-neon/30 hover:shadow-glow-neon"
										: "border-primary/10 hover:border-primary/30 hover:shadow-glow-primary",
								]}
							>
								{/* Background number */}
								<span
									class:list={[
										"pointer-events-none absolute top-2 right-4 font-heading text-[6rem] font-black leading-none select-none",
										isNeon ? "text-neon/[0.04]" : "text-primary/[0.05]",
									]}
								>
									{String(i + 1).padStart(2, "0")}
								</span>

								<p class="relative text-base font-medium leading-relaxed text-text lg:text-lg">
									{result}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- CTA — siguiente proyecto o contacto -->
		<section class="relative border-t border-border/30 bg-surface py-18 lg:py-26">
			<div class="mx-auto max-w-4xl px-6 text-center">
				<p class="mb-4 font-mono text-xs font-medium tracking-[0.3em] text-muted uppercase">
					¿Listo para lo tuyo?
				</p>
				<h2 class="mb-8 font-heading text-3xl font-black tracking-tight text-text sm:text-4xl lg:text-5xl">
					HAGAMOS ALGO<br />
					<span class:list={[isNeon ? "text-neon" : "text-primary"]}>EXTRAORDINARIO</span>
				</h2>
				<div class="flex flex-wrap items-center justify-center gap-4">
					<a
						href="/#contacto"
						class="group inline-flex items-center gap-2 rounded-lg bg-primary px-7 py-3.5 text-sm font-semibold tracking-wider text-white uppercase transition-all hover:bg-primary-hover hover:shadow-glow-primary"
					>
						Iniciar proyecto
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-4 transition-transform group-hover:translate-x-0.5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
						</svg>
					</a>
					<a
						href="/#proyectos"
						class="inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm font-semibold tracking-wider text-muted uppercase transition-all hover:border-text/30 hover:text-text"
					>
						Ver más proyectos
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
