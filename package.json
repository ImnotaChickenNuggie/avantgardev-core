{
  "name": "avantgardev",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check ./src",
    "lint:fix": "biome check --fix ./src",
    "format": "biome format --write ./src",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "clsx": "^2.1.1",
    "cursor-style": "^1.5.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "biome check --fix --no-errors-on-unmatched"
    ],
    "*.{json,css}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
